# E3.1 HetSub tile top synthesis — Nangate45 typ, 1 GHz, flops buffers.
# Same flow as Baseline (E1.2): liberty + techmap + abc, hierarchical top.
read_liberty pdk/Nangate45_typ_yosys.lib
read_verilog src/rr_arb.v src/vc_buffer.v src/rc_xy.v src/rc_mono.v src/vc_table.v src/vc_alloc.v src/sw_alloc.v src/crossbar.v src/hetsub_l_router.v src/hetsub_m_router.v src/hetsub_relay_tx.v src/hetsub_relay_rx.v src/hetsub_bypass.v src/hetsub_select_pg.v src/hetsub_tile_top.v
hierarchy -check -top hetsub_tile_top
# opt -noff: Nangate45 has no enable-DFF cells, so clock-enable folding is
# disabled; every FF stays a plain DFF that dfflibmap maps to a library cell
# (no unknown-area/behavioral leftovers). Applied identically to both designs.
proc; opt -noff; techmap; dfflibmap -liberty pdk/Nangate45_typ_yosys.lib; abc -liberty pdk/Nangate45_typ_yosys.lib -script syn/abc_default.abc
opt_clean -purge
stat -liberty pdk/Nangate45_typ_yosys.lib
write_verilog syn/out_hetsub_netlist.v
