# Shell scripts - Build and test automation
!*.sh

# Documentation - Project documentation
!*.md
!README*
!CLAUDE.md
!*_README.md

# Python scripts - Analysis and generation tools
!*.py

# Configuration files
!*.yaml
!*.yml
!*.json
!*.conf
!*.cfg

# Text files - Small reference files
!*.txt
# But exclude large text files
comparison_report.txt
running-gem5-gpu-output.txt

# Reports - Small PDF reports (exclude large papers above)
!reports/
!*Report.pdf
!MVPP_MGC_PSO_Evaluation_Metrics_Report.pdf

# Images - Documentation images
!images/

# Manuscript - Research manuscript
!manuscript/

# Source code snippets (if any at root level)
!*.c
!*.cpp
!*.h
!*.hpp
!*.cu

